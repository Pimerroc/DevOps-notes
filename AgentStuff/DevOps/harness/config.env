# config.env — единый источник путей для harness.
#
# Синхронизировано с: AGENTS.md (структура + стейдж-правила), commit.sh,
# opencode.jsonc (edit-разрешения). После изменения путей:
#   1) обновить здесь; 2) ./install.sh && ./doctor.sh; 3) перезагрузить агентов.
#
# Файл источник-баш: source-ится из run.sh / brief.sh / commit.sh / doctor.sh.

# Корень vault. Переменная окружения VAULT_ROOT, заданная до source, побеждает.
VAULT_ROOT="${VAULT_ROOT:-$HOME/DevOps_Notes}"

AGENTSTUFF_ROOT="$VAULT_ROOT/AgentStuff"
HARNESS_ROOT="$AGENTSTUFF_ROOT/DevOps/harness"

# Код-артефакты практик (Go, livecoding, стенды) и заметки-лабы.
PRACTICE_CODE_ROOT="$VAULT_ROOT/DevOpsNotes/Practice"
PRACTICE_NOTES_ROOT="$VAULT_ROOT/DevOpsNotes/Practice Theory"
LIVECODING_ROOT="$PRACTICE_CODE_ROOT/livecoding"

TEMPLATES_ROOT="$VAULT_ROOT/Templates"

# Пути автокоммита вечернего ритуала. SYNC: AGENTS.md → «Автокоммит».
COMMIT_PATHS=(
  DevOpsNotes/DevOps
  DevOpsNotes/DevOps.md
  DevOpsNotes/Practice
  "DevOpsNotes/Practice Theory"
  DevOpsNotes/Networks
  AgentStuff
  Templates
)
COMMIT_PATHS_RE='^(DevOpsNotes/DevOps/|DevOpsNotes/DevOps\.md$|DevOpsNotes/Practice/|DevOpsNotes/Practice Theory/|DevOpsNotes/Networks/|AgentStuff/|Templates/)'

# vault-lint: не линтуем журналы-историю (ссылки прошлых лет), шаблоны
# (плейсхолдеры пусты по дизайну) и AGENTS.md (примеры ссылок в правилах).
LINT_SKIP_PATHS=(
  "DevOpsNotes/DevOps/Learning Log.md"
  "DevOpsNotes/DevOps/Board.md"
  "Templates"
  "AGENTS.md"
)

# systemd user unit ритуалов (для doctor.sh).
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
RITUAL_UNIT="devops-ritual@.service"
