{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "devops",
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "deny" },
    { "action": "edit", "resource": "DevOpsNotes/DevOps/**", "effect": "allow" },
    { "action": "edit", "resource": "DevOpsNotes/DevOps.md", "effect": "allow" },
    { "action": "edit", "resource": "DevOpsNotes/Images/**", "effect": "allow" },
    { "action": "edit", "resource": "Practice/DevOps/**", "effect": "allow" },
    { "action": "edit", "resource": "Templates/**", "effect": "allow" },

    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*/.obsidian/*", "effect": "deny" },

    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/opencode/**", "effect": "allow" },

    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "* --help", "effect": "allow" },
    { "action": "shell", "resource": "* --version", "effect": "allow" },
    { "action": "shell", "resource": "man *", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" }
  ]
}
