{
 "nodes": [
  {
   "id": "n1",
   "type": "text",
   "text": "# Глава 3\n**Канальный уровень**\n\n[[Глава 3]]",
   "x": 910,
   "y": 0,
   "width": 300,
   "height": 150,
   "color": "6"
  },
  {
   "id": "n2",
   "type": "text",
   "text": "## Четыре задачи уровня",
   "x": 60,
   "y": 190,
   "width": 240,
   "height": 70,
   "color": "1"
  },
  {
   "id": "n3",
   "type": "text",
   "text": "**Служба**\nинтерфейс сетевому уровню\n\nстр. 243",
   "x": 60,
   "y": 300,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n4",
   "type": "text",
   "text": "**Фрейминг**\nиз потока байтов\n\nстр. 246",
   "x": 340,
   "y": 300,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n5",
   "type": "text",
   "text": "**Обработка ошибок**\nровно один раз\n\nстр. 250",
   "x": 620,
   "y": 300,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n6",
   "type": "text",
   "text": "**Управление потоком**\n«пожарный шланг»\n\nстр. 251",
   "x": 900,
   "y": 300,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n7",
   "type": "text",
   "text": "## Три службы сетевому уровню",
   "x": 1190,
   "y": 190,
   "width": 240,
   "height": 70,
   "color": "2"
  },
  {
   "id": "n8",
   "type": "text",
   "text": "**Без подтверждений**\nбез соединения\n\nEthernet",
   "x": 1190,
   "y": 300,
   "width": 250,
   "height": 110,
   "color": "2"
  },
  {
   "id": "n9",
   "type": "text",
   "text": "**С подтверждениями**\nбез соединения\n\n802.11",
   "x": 1470,
   "y": 300,
   "width": 250,
   "height": 110,
   "color": "2"
  },
  {
   "id": "n10",
   "type": "text",
   "text": "**С подтверждениями**\nс соединением\n\nспутник, междугородняя",
   "x": 1750,
   "y": 300,
   "width": 250,
   "height": 110,
   "color": "2"
  },
  {
   "id": "n11",
   "type": "text",
   "text": "## Четыре метода фрейминга",
   "x": 60,
   "y": 450,
   "width": 240,
   "height": 70,
   "color": "4"
  },
  {
   "id": "n12",
   "type": "text",
   "text": "**Подсчёт байтов**\nне применяется\n\n5 → 7 и всё",
   "x": 60,
   "y": 560,
   "width": 250,
   "height": 110,
   "color": "4"
  },
  {
   "id": "n13",
   "type": "text",
   "text": "**Байт-стаффинг**\nFLAG 0x7E · ESC 0x7D\n\nPPP",
   "x": 340,
   "y": 560,
   "width": 250,
   "height": 110,
   "color": "4"
  },
  {
   "id": "n14",
   "type": "text",
   "text": "**Бит-стаффинг**\nпять единиц → 0\n\nHDLC · USB",
   "x": 60,
   "y": 700,
   "width": 250,
   "height": 110,
   "color": "4"
  },
  {
   "id": "n15",
   "type": "text",
   "text": "**Запрещённые сигналы**\n4B/5B: 16 из 32\n\nданные не трогаются",
   "x": 340,
   "y": 700,
   "width": 250,
   "height": 110,
   "color": "4"
  },
  {
   "id": "n16",
   "type": "text",
   "text": "## Обнаружение или коррекция",
   "x": 630,
   "y": 450,
   "width": 240,
   "height": 70,
   "color": "3"
  },
  {
   "id": "n17",
   "type": "text",
   "text": "**FEC**\nупреждающая коррекция\n\nисправляет на месте",
   "x": 630,
   "y": 560,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n18",
   "type": "text",
   "text": "**Хэмминг (11, 7)**\nсиндром указывает бит\n\nрасстояние 3",
   "x": 910,
   "y": 560,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n19",
   "type": "text",
   "text": "**CRC**\nтолько обнаруживает\n\nостаток ≠ 0 → повтор",
   "x": 1190,
   "y": 560,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n20",
   "type": "text",
   "text": "**Рида — Соломона**\nсимволы, не биты\n\n2t → t ошибок",
   "x": 630,
   "y": 700,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n21",
   "type": "text",
   "text": "**LDPC**\nнизкая плотность\n\n10 Гбит/с Ethernet",
   "x": 910,
   "y": 700,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n22",
   "type": "text",
   "text": "**Чередование**\nпакеты ошибок\n\nn бит чётности",
   "x": 1190,
   "y": 700,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n23",
   "type": "text",
   "text": "## Что именно обнаруживает CRC",
   "x": 60,
   "y": 850,
   "width": 240,
   "height": 70,
   "color": "3"
  },
  {
   "id": "n24",
   "type": "text",
   "text": "**Однобитовые**\n\nвсе",
   "x": 60,
   "y": 960,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n25",
   "type": "text",
   "text": "**Нечёткое число битов**\n\nполовина ошибок",
   "x": 340,
   "y": 960,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n26",
   "type": "text",
   "text": "**Пакет ≤ r**\n\nвсе",
   "x": 620,
   "y": 960,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n27",
   "type": "text",
   "text": "**Пакет r + 1**\n\nвероятность (1/2)^(r−1)",
   "x": 900,
   "y": 960,
   "width": 250,
   "height": 110,
   "color": "3"
  },
  {
   "id": "n28",
   "type": "text",
   "text": "## Формулы главы",
   "x": 1190,
   "y": 850,
   "width": 240,
   "height": 70,
   "color": "6"
  },
  {
   "id": "n29",
   "type": "text",
   "text": "**(3.1)**\nm + r + 1 ≤ 2^r\n\nнижний предел",
   "x": 1190,
   "y": 960,
   "width": 250,
   "height": 110,
   "color": "6"
  },
  {
   "id": "n30",
   "type": "text",
   "text": "**w = 2·BD + 1**\nразмер окна\n\nполоса × задержка",
   "x": 1470,
   "y": 960,
   "width": 250,
   "height": 110,
   "color": "6"
  },
  {
   "id": "n31",
   "type": "text",
   "text": "**BD**\nполоса × задержка\n\nизмеряется во фреймах",
   "x": 1190,
   "y": 1100,
   "width": 250,
   "height": 110,
   "color": "6"
  },
  {
   "id": "n32",
   "type": "text",
   "text": "**CRC-32 IEEE**\nпакеты ≤ 32 бита\n\nрасстояние всего 4",
   "x": 1470,
   "y": 1100,
   "width": 250,
   "height": 110,
   "color": "6"
  },
  {
   "id": "n33",
   "type": "text",
   "text": "## Шесть протоколов",
   "x": 60,
   "y": 1250,
   "width": 240,
   "height": 70,
   "color": "5"
  },
  {
   "id": "n34",
   "type": "text",
   "text": "**1. Утопия**\nничего\n\nидеальный канал",
   "x": 60,
   "y": 1360,
   "width": 250,
   "height": 110,
   "color": "5"
  },
  {
   "id": "n35",
   "type": "text",
   "text": "**2. Остановка и ожидание**\nуправление потоком\n\nсимплексный",
   "x": 340,
   "y": 1360,
   "width": 250,
   "height": 110,
   "color": "5"
  },
  {
   "id": "n36",
   "type": "text",
   "text": "**3. PAR / ARQ**\nномера и подтверждения\n\nMAX_SEQ = 1",
   "x": 620,
   "y": 1360,
   "width": 250,
   "height": 110,
   "color": "5"
  },
  {
   "id": "n37",
   "type": "text",
   "text": "**4. Окно 1 бит**\nвложенные подтверждения\n\nдуплексный",
   "x": 60,
   "y": 1500,
   "width": 250,
   "height": 110,
   "color": "5"
  },
  {
   "id": "n38",
   "type": "text",
   "text": "**5. Возврат к n**\nMAX_SEQ = 7\n\nокно растёт",
   "x": 340,
   "y": 1500,
   "width": 250,
   "height": 110,
   "color": "5"
  },
  {
   "id": "n39",
   "type": "text",
   "text": "**6. Выборочный повтор**\nNR_BUFS = 4\n\nбуфер и NAK",
   "x": 620,
   "y": 1500,
   "width": 250,
   "height": 110,
   "color": "5"
  },
  {
   "id": "n40",
   "type": "text",
   "text": "## Раздвижное окно",
   "x": 910,
   "y": 1250,
   "width": 240,
   "height": 70,
   "color": "2"
  },
  {
   "id": "n41",
   "type": "text",
   "text": "**Поле номера**\nn бит → 2ⁿ − 1\n\nне то же, что окно",
   "x": 910,
   "y": 1360,
   "width": 250,
   "height": 110,
   "color": "2"
  },
  {
   "id": "n42",
   "type": "text",
   "text": "**Окно ≤ половины**\nв протоколе 6\n\nиначе перекрытие",
   "x": 1190,
   "y": 1360,
   "width": 250,
   "height": 110,
   "color": "2"
  },
  {
   "id": "n43",
   "type": "text",
   "text": "**Кумулятивное**\nack n значит и n−1\n\nи все предыдущие",
   "x": 910,
   "y": 1500,
   "width": 250,
   "height": 110,
   "color": "2"
  },
  {
   "id": "n44",
   "type": "text",
   "text": "**ack = последний**\n(frame_exp + MAX_SEQ) % …\n\nне следующий",
   "x": 1190,
   "y": 1500,
   "width": 250,
   "height": 110,
   "color": "2"
  },
  {
   "id": "n45",
   "type": "text",
   "text": "## Практические протоколы",
   "x": 60,
   "y": 1650,
   "width": 240,
   "height": 70,
   "color": "1"
  },
  {
   "id": "n46",
   "type": "text",
   "text": "**PPP**\nфрейминг · LCP · NCP\n\nобычно без подтверждений",
   "x": 60,
   "y": 1760,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n47",
   "type": "text",
   "text": "**HDLC**\nбит-ориентированный\n\nнадёжная передача",
   "x": 340,
   "y": 1760,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n48",
   "type": "text",
   "text": "**ATM**\nячейки по 53 байта\n\n48 данных + 5",
   "x": 620,
   "y": 1760,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n49",
   "type": "text",
   "text": "**AAL5**\nLength + CRC\n\nпакетные данные",
   "x": 60,
   "y": 1900,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n50",
   "type": "text",
   "text": "**DOCSIS**\nPHY · MAC\n\nMAC — в главе 4",
   "x": 340,
   "y": 1900,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n51",
   "type": "text",
   "text": "**Скремблирование**\nXOR с ПСЧ\n\nдля синхронизации",
   "x": 620,
   "y": 1900,
   "width": 250,
   "height": 110,
   "color": "1"
  },
  {
   "id": "n52",
   "type": "text",
   "text": "## Чего в главе 3 нет",
   "x": 910,
   "y": 1650,
   "width": 240,
   "height": 70,
   "color": "6"
  },
  {
   "id": "n53",
   "type": "text",
   "text": "**LLC / SNAP**\n\nнет ни разу — это глава 4",
   "x": 910,
   "y": 1760,
   "width": 250,
   "height": 110,
   "color": "6"
  },
  {
   "id": "n54",
   "type": "text",
   "text": "**Кадр Ethernet**\nкак структура\n\nтолько упоминания",
   "x": 1190,
   "y": 1760,
   "width": 250,
   "height": 110,
   "color": "6"
  },
  {
   "id": "n55",
   "type": "text",
   "text": "**Таблица кодов CRC**\n\nесть только правила",
   "x": 910,
   "y": 1900,
   "width": 250,
   "height": 110,
   "color": "6"
  },
  {
   "id": "n56",
   "type": "text",
   "text": "**VPI / VCI · STS · BER**\n\nв других главах",
   "x": 1190,
   "y": 1900,
   "width": 250,
   "height": 110,
   "color": "6"
  }
 ],
