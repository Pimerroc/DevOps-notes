{
	"nodes":[
		{"id":"n1","type":"text","text":"# Глава 2\n**Физический уровень**\n\n[[Глава 2]]","x":910,"y":0,"width":300,"height":150,"color":"6"},
		{"id":"n2","type":"text","text":"## Среды передачи","x":60,"y":190,"width":240,"height":70,"color":"2"},
		{"id":"n3","type":"text","text":"**Витая пара**\nсотни Мбит/с\n20 дБ за 100 м\n\nповторитель раз в 5 км","x":60,"y":300,"width":250,"height":110,"color":"2"},
		{"id":"n4","type":"text","text":"**Коаксиал**\nдо 6 ГГц\nэкранирован\n\n50 и 75 Ом","x":340,"y":300,"width":250,"height":110,"color":"2"},
		{"id":"n5","type":"text","text":"**ЛЭП**\nсигнал от 1 МГц\n\nпроводка как антенна","x":620,"y":300,"width":250,"height":110,"color":"2"},
		{"id":"n6","type":"text","text":"**Оптоволокно**\nпотери < 5 %/км\n\nповторитель раз в 50 км","x":900,"y":300,"width":250,"height":110,"color":"2"},
		{"id":"n7","type":"text","text":"## Расширение спектра","x":1190,"y":190,"width":240,"height":70,"color":"5"},
		{"id":"n8","type":"text","text":"**FHSS**\nпрыгает по частотам\n\nBluetooth · старый 802.11","x":1190,"y":300,"width":250,"height":110,"color":"5"},
		{"id":"n9","type":"text","text":"**DSSS**\nразмазывает кодом\n\n3G · GPS · 802.11b","x":1470,"y":300,"width":250,"height":110,"color":"5"},
		{"id":"n10","type":"text","text":"**UWB**\n≥ 500 МГц или ≥ 20 %\n\nне мешает другим","x":1750,"y":300,"width":250,"height":110,"color":"5"},
		{"id":"n11","type":"text","text":"## Линейные коды","x":60,"y":450,"width":240,"height":70,"color":"1"},
		{"id":"n12","type":"text","text":"**NRZ**\nдешевле всего\n\nзалипает на единицах","x":60,"y":560,"width":250,"height":110,"color":"1"},
		{"id":"n13","type":"text","text":"**NRZI**\nединица — переход\n\nприменяется в USB","x":340,"y":560,"width":250,"height":110,"color":"1"},
		{"id":"n14","type":"text","text":"**Манчестер**\nпереход в середине\n\nполоса вдвое больше","x":620,"y":560,"width":250,"height":110,"color":"1"},
		{"id":"n15","type":"text","text":"**4B/5B**\nне более 3 нулей\n\nизбыточность 25 %","x":60,"y":700,"width":250,"height":110,"color":"1"},
		{"id":"n16","type":"text","text":"**8B/10B**\nКПД 80 %\n\nFibre Channel","x":340,"y":700,"width":250,"height":110,"color":"1"},
		{"id":"n17","type":"text","text":"**AMI**\nсреднее = 0\n\nтелефонные сети","x":620,"y":700,"width":250,"height":110,"color":"1"},
		{"id":"n18","type":"text","text":"## Цифровая модуляция","x":910,"y":450,"width":240,"height":70,"color":"4"},
		{"id":"n19","type":"text","text":"**ASK**\nсдвиг амплитуды\n\n1 бит/символ","x":910,"y":560,"width":250,"height":110,"color":"4"},
		{"id":"n20","type":"text","text":"**FSK**\nсдвиг частоты\n\nсозвездие не рисуется","x":1190,"y":560,"width":250,"height":110,"color":"4"},
		{"id":"n21","type":"text","text":"**PSK / BPSK**\nсдвиг фазы\n\n1 бит/символ","x":1470,"y":560,"width":250,"height":110,"color":"4"},
		{"id":"n22","type":"text","text":"**QPSK**\n4 фазы\n\n2 бита/символ","x":910,"y":700,"width":250,"height":110,"color":"4"},
		{"id":"n23","type":"text","text":"**QAM**\nамплитуда + фаза\n\nчастоту с фазой нельзя","x":1190,"y":700,"width":250,"height":110,"color":"4"},
		{"id":"n24","type":"text","text":"**Код Грея**\nсоседи — 1 бит\n\nшум портит один бит","x":1470,"y":700,"width":250,"height":110,"color":"4"},
		{"id":"n25","type":"text","text":"## Бод — ключевое понятие","x":60,"y":850,"width":240,"height":70,"color":"3"},
		{"id":"n26","type":"text","text":"**битрейт**\n= бодрейт × бит/символ\n\nбод = символы/с","x":60,"y":960,"width":250,"height":110,"color":"3"},
		{"id":"n27","type":"text","text":"**V.32**\n2400 бод · 4 бит\n= 9600 бит/с\n\nQAM-16","x":340,"y":960,"width":250,"height":110,"color":"3"},
		{"id":"n28","type":"text","text":"## Две теоремы","x":630,"y":850,"width":240,"height":70,"color":"6"},
		{"id":"n29","type":"text","text":"**Найквист**\n2·B·log₂V бит/с\n\nпотолок системы","x":630,"y":960,"width":250,"height":110,"color":"6"},
		{"id":"n30","type":"text","text":"**Шеннон**\nB·log₂(1+S/N)\n\nпотолок из-за шума","x":910,"y":960,"width":250,"height":110,"color":"6"},
		{"id":"n31","type":"text","text":"## Мультиплексирование","x":1200,"y":850,"width":240,"height":70,"color":"5"},
		{"id":"n32","type":"text","text":"**FDM**\nпо частоте\n\nзащитные полосы","x":1200,"y":960,"width":250,"height":110,"color":"5"},
		{"id":"n33","type":"text","text":"**OFDM**\nортогональные несущие\n\nзащитный интервал","x":1480,"y":960,"width":250,"height":110,"color":"5"},
		{"id":"n34","type":"text","text":"**TDM**\nпо времени\n\nзащитные интервалы","x":1760,"y":960,"width":250,"height":110,"color":"5"},
		{"id":"n35","type":"text","text":"**STDM**\nпо статистике\n\nэто пакетная коммутация","x":1200,"y":1100,"width":250,"height":110,"color":"5"},
		{"id":"n36","type":"text","text":"**WDM**\nпо длине волны\n\nпассивная решётка","x":1480,"y":1100,"width":250,"height":110,"color":"5"},
		{"id":"n37","type":"text","text":"**CDM**\nпо кодам\n\n64 или 128 чипов","x":1760,"y":1100,"width":250,"height":110,"color":"5"},
		{"id":"n38","type":"text","text":"## Телефонная сеть","x":60,"y":1250,"width":240,"height":70,"color":"3"},
		{"id":"n39","type":"text","text":"**PCM**\n8000 сэмплов/с\n8 бит = 64 Кбит/с\n\nинтервал 125 мкс","x":60,"y":1360,"width":250,"height":110,"color":"3"},
		{"id":"n40","type":"text","text":"**T1**\n24 канала · 193 бита\n1,544 Мбит/с\n\nАмерика и Япония","x":340,"y":1360,"width":250,"height":110,"color":"3"},
		{"id":"n41","type":"text","text":"**E1**\n32 сэмпла\n2,048 Мбит/с\n\nостальной мир","x":620,"y":1360,"width":250,"height":110,"color":"3"},
		{"id":"n42","type":"text","text":"**SONET**\nSTS-1 = 51,84 Мбит/с\n\nс 1989 года","x":60,"y":1500,"width":250,"height":110,"color":"3"},
		{"id":"n43","type":"text","text":"**SDH**\nначинается со STM-1\n155,52 Мбит/с\n\nнет скорости ≈ 51,84","x":340,"y":1500,"width":250,"height":110,"color":"3"},
		{"id":"n44","type":"text","text":"**Каналы против пакетов**\n\n10 с на установление","x":620,"y":1500,"width":250,"height":110,"color":"3"},
		{"id":"n45","type":"text","text":"## xDSL и оптика доступа","x":910,"y":1250,"width":240,"height":70,"color":"5"},
		{"id":"n46","type":"text","text":"**Фильтр затухания**\n300 и 3400 Гц\n\nобходится при DSL","x":910,"y":1360,"width":250,"height":110,"color":"5"},
		{"id":"n47","type":"text","text":"**1,1 МГц**\n256 каналов\nпо 4312,5 Гц\n\nканал 0 — голос","x":1190,"y":1360,"width":250,"height":110,"color":"5"},
		{"id":"n48","type":"text","text":"**DMT**\nреализация OFDM\n\nоснова ADSL","x":1470,"y":1360,"width":250,"height":110,"color":"5"},
		{"id":"n49","type":"text","text":"**VDSL2**\n200 / 100 Мбит/с\n\nполоса 12 МГц","x":910,"y":1500,"width":250,"height":110,"color":"5"},
		{"id":"n50","type":"text","text":"**G.fast**\n~1 Гбит/с на 100 м\n\nсвязывание пар","x":1190,"y":1500,"width":250,"height":110,"color":"5"},
		{"id":"n51","type":"text","text":"**PON**\nGPON · EPON\n\nдо 20 км, пассивная","x":1470,"y":1500,"width":250,"height":110,"color":"5"},
		{"id":"n52","type":"text","text":"## Сотовые сети и спутники","x":60,"y":1650,"width":240,"height":70,"color":"4"},
		{"id":"n53","type":"text","text":"**1G → 2G**\nаналог → цифровой голос\n\nAMPS → GSM","x":60,"y":1760,"width":250,"height":110,"color":"4"},
		{"id":"n54","type":"text","text":"**3G**\nголос и данные\n\nWCDMA · CDMA2000","x":340,"y":1760,"width":250,"height":110,"color":"4"},
		{"id":"n55","type":"text","text":"**4G**\nкоммутация пакетов\n\nEPC · eNodeB","x":620,"y":1760,"width":250,"height":110,"color":"4"},
		{"id":"n56","type":"text","text":"**5G**\nплощадь × 1000\n\nмиллиметровые волны","x":60,"y":1900,"width":250,"height":110,"color":"4"},
		{"id":"n57","type":"text","text":"**GEO**\n35 000 км · 270 мс\n\n3 спутника","x":340,"y":1900,"width":250,"height":110,"color":"4"},
		{"id":"n58","type":"text","text":"**LEO**\n1–7 мс · 50 спутников\n\nмного спутников","x":620,"y":1900,"width":250,"height":110,"color":"4"},
		{"id":"n59","type":"text","text":"## Чего в главе 2 нет","x":910,"y":1650,"width":240,"height":70,"color":"6"},
		{"id":"n60","type":"text","text":"**BER, RTT**\n\nтермины не введены","x":910,"y":1760,"width":250,"height":110,"color":"6"},
		{"id":"n61","type":"text","text":"**ATM, CRC**\n\nв главе 3","x":1190,"y":1760,"width":250,"height":110,"color":"6"},
		{"id":"n62","type":"text","text":"**UTP, STP**\n\nUTP есть, STP нет","x":1470,"y":1760,"width":250,"height":110,"color":"6"},
		{"id":"n63","type":"text","text":"**RJ-45, BRI, PRI**\n\nне упоминаются","x":1750,"y":1760,"width":250,"height":110,"color":"6"}
	],
