{
	"nodes":[
		{"id":"n1","type":"text","text":"# Глава 4\n**MAC**\nПодуровень управления\nдоступом к среде\n\n[[Глава 4]]","x":0,"y":300,"width":300,"height":120,"color":"6"},
		{"id":"n2","type":"text","text":"**4.1 Проблема канала**\nодин канал — много желающих","x":0,"y":-420,"width":300,"height":90,"color":"2"},
		{"id":"n4","type":"text","text":"Статическое FDM / TDM\n`T = 1/(μC − λ)`\nделение на N хуже в N раз","x":0,"y":-240,"width":300,"height":90,"color":"3"},
		{"id":"n5","type":"text","text":"Пять допущений\nпуассон · единый канал ·\nколлизии · время · несущая","x":0,"y":-60,"width":300,"height":90,"color":"3"},
		{"id":"n6","type":"text","text":"**4.2.1 ALOHA**\nуязвимый период","x":380,"y":-420,"width":300,"height":90,"color":"5"},
		{"id":"n8","type":"text","text":"**чистая** ALOHA\n`S = G·e^(−2G)`\n`max = 1/2e ≈ 0,184`\nуязвимый период **2t**","x":380,"y":-240,"width":300,"height":110,"color":"5"},
		{"id":"n9","type":"text","text":"**дискретная** ALOHA\n`S = G·e^(−G)`\n`max = 1/e ≈ 0,368`\nуязвимый период **t**","x":380,"y":-40,"width":300,"height":110,"color":"5"},
		{"id":"n10","type":"text","text":"**4.2.2 CSMA/CD**\nконтроль несущей + аналоговое\nобнаружение коллизии","x":760,"y":-420,"width":300,"height":90,"color":"5"},
		{"id":"n12","type":"text","text":"**2τ** — слот конкуренции\nвсплеск возвращается за 2τ\nв Ethernet = **512 бит = 51,2 мкс**","x":760,"y":-240,"width":300,"height":110,"color":"5"},
		{"id":"n13","type":"text","text":"**двоичная экспоненциальная\nвыдержка**\n`0 … 2^i − 1`\nпотолок **1023** после 10,\nотказ после **16**","x":760,"y":-40,"width":300,"height":130,"color":"5"},
		{"id":"n14","type":"text","text":"минимум фрейма **64 байта**\nвремя передачи должно быть > 2τ","x":760,"y":180,"width":300,"height":90,"color":"5"},
		{"id":"n15","type":"text","text":"**4.2.3 Протоколы без коллизий**","x":1140,"y":-420,"width":300,"height":90,"color":"5"},
		{"id":"n17","type":"text","text":"битовая карта\nнакладные **N** бит\n(при сильной загрузке — 1)","x":1140,"y":-240,"width":300,"height":90,"color":"4"},
		{"id":"n18","type":"text","text":"двоичный обратный отсчёт\nнакладные **log₂N** бит\nпобеждает наибольший адрес","x":1140,"y":-60,"width":300,"height":90,"color":"4"},
		{"id":"n19","type":"text","text":"маркерное кольцо 802.5\nмаркерная шина **802.4 — отменён**","x":1140,"y":120,"width":300,"height":90,"color":"4"},
		{"id":"n20","type":"text","text":"**4.2.4 Ограниченная конкуренция**","x":1520,"y":-420,"width":300,"height":90,"color":"5"},
		{"id":"n22","type":"text","text":"симметричный случай\n`p = 1/k`, при k → ∞\nвероятность стремится к `1/e`","x":1520,"y":-240,"width":300,"height":90,"color":"4"},
		{"id":"n23","type":"text","text":"групповой арбитраж\nмелкие группы при высокой загрузке","x":1520,"y":-60,"width":300,"height":90,"color":"4"},
		{"id":"n24","type":"text","text":"адаптивный проход по дереву\n`i = log₂q`,\nгде `2⁻ⁱ·q = 1`","x":1520,"y":120,"width":300,"height":110,"color":"4"},
		{"id":"n25","type":"text","text":"**4.2.5 WLAN**\nдве проблемы радиоэфира","x":1900,"y":-420,"width":300,"height":90,"color":"5"},
		{"id":"n27","type":"text","text":"**скрытая станция**\nне слышит конкурента → коллизия","x":1900,"y":-240,"width":300,"height":90,"color":"1"},
		{"id":"n28","type":"text","text":"**засвеченная станция**\nмолчит впустую, коллизии нет","x":1900,"y":-60,"width":300,"height":90,"color":"1"},
		{"id":"n29","type":"text","text":"**MACA**\nRTS → CTS → данные\nзапрет говорить вместо\nконтроля несущей","x":1900,"y":120,"width":300,"height":110,"color":"4"},
		{"id":"n32","type":"text","text":"классический 3–10 Мбит/с\nманчестер · 2500 м ·\nне более 4 повторителей","x":2280,"y":-240,"width":300,"height":110,"color":"3"},
		{"id":"n33","type":"text","text":"формат фрейма\nDIX **Type** vs 802.3 **Length**\nграница **0x600 = 1536**\n`0x0800` = IPv4 · `0x8100` = VLAN","x":2280,"y":-40,"width":300,"height":130,"color":"3"},
		{"id":"n34","type":"text","text":"**hub** — одна область коллизий,\npromiscuous-видимый трафик\n**switch** — своя на каждый порт","x":2280,"y":180,"width":300,"height":110,"color":"3"},
		{"id":"n35","type":"text","text":"эффективность (4.3)\n`S = F / (F + e·слот)`\nнакладные ≈ **174 байта**\nF = 1024 Б → **85 %**","x":2280,"y":380,"width":300,"height":130,"color":"3"},
		{"id":"n36","type":"text","text":"Fast → Gig → 10G → 100G\nс 10G только полный дуплекс\n`4B/5B` → `8B/10B` → `64B/66B`","x":2280,"y":600,"width":300,"height":130,"color":"3"},
		{"id":"n37","type":"text","text":"GigE: carrier extension\nдо 512 Б → **9 %**,\nи frame bursting","x":2280,"y":820,"width":300,"height":110,"color":"3"},
		{"id":"n38","type":"text","text":"**4.4 802.11**","x":2660,"y":-420,"width":300,"height":90,"color":"4"},
		{"id":"n40","type":"text","text":"**DCF / CSMA/CA**\nполудуплекс, сигнал в 10⁶ раз\nслабее ⇒ только предотвращение","x":2660,"y":-240,"width":300,"height":110,"color":"1"},
		{"id":"n41","type":"text","text":"интервалы\n**SIFS < AIFS1 < DIFS < AIFS4**\nEIFS — после битого кадра","x":2660,"y":-40,"width":300,"height":130,"color":"3"},
		{"id":"n42","type":"text","text":"**NAV** — виртуальное\nпрослушивание; в ax\n**два** поля NAV","x":2660,"y":180,"width":300,"height":110,"color":"3"},
		{"id":"n43","type":"text","text":"**RTS / CTS**\nлечит только **скрытую**,\nзасвеченную — нет","x":2660,"y":380,"width":300,"height":110,"color":"3"},
		{"id":"n44","type":"text","text":"**TXOP**\nравное время, а не равное число\nкадров: 3 и 27 Мбит/с\n(аномалия скорости)","x":2660,"y":580,"width":300,"height":130,"color":"3"},
		{"id":"n45","type":"text","text":"физика b / a / g / n / ac / ax\n`ac`: 256-QAM, 7 Гбит/с\n`ax`: 1024-QAM + OFDMA, 11 Гбит/с","x":2660,"y":800,"width":300,"height":130,"color":"3"},
		{"id":"n46","type":"text","text":"**4.5 Bluetooth**","x":0,"y":1120,"width":300,"height":90,"color":"4"},
		{"id":"n48","type":"text","text":"пикосеть\n1 главный + до 7 активных\n+ до 255 запаркованных,\nрадиус ~10 м","x":0,"y":1300,"width":300,"height":130,"color":"3"},
		{"id":"n49","type":"text","text":"слот **625 мкс** ·\n**1600** скачков/с ·\n**79** каналов по 1 МГц","x":0,"y":1520,"width":300,"height":110,"color":"3"},
		{"id":"n50","type":"text","text":"заголовок **18 бит × 3 = 54**\nголосование большинством\nSCO до **3**, ACL только **1**","x":0,"y":1720,"width":300,"height":130,"color":"3"},
		{"id":"n51","type":"text","text":"эффективность **13 %**\n41 % стабилизация ·\n20 % заголовки ·\n26 % повторное кодирование","x":0,"y":1940,"width":300,"height":130,"color":"3"},
		{"id":"n52","type":"text","text":"**4.6 DOCSIS**","x":760,"y":1120,"width":300,"height":90,"color":"4"},
		{"id":"n54","type":"text","text":"мини-слот **6,25 мкс** → QoS\nобычный: планирование 2–4 мс\n**LLD**: 1 мс + две очереди\n+ проактивное планирование","x":760,"y":1300,"width":300,"height":130,"color":"3"},
		{"id":"n55","type":"text","text":"**4.7 Коммутация на канальном уровне**","x":1520,"y":1120,"width":300,"height":90,"color":"4"},
		{"id":"n57","type":"text","text":"**обратное обучение** —\nпо **ОТПРАВИТЕЛЮ**\nлавина — по **ПОЛУЧАТЕЛЮ**\nтри правила пересылки","x":1520,"y":1300,"width":300,"height":130,"color":"1"},
		{"id":"n58","type":"text","text":"**связующее дерево**\nкорень = **минимальный MAC**\nIEEE 802.1D,\nалгоритм Радьи Перлман","x":1520,"y":1520,"width":300,"height":130,"color":"3"},
		{"id":"n59","type":"text","text":"**802.1Q / VLAN**\n**4 байта**, `0x8100`\nVID **12 бит** = 4096 VLAN\nлимит 1518 → **1522** байта\nработает как с установлением соединения","x":1520,"y":1740,"width":300,"height":160,"color":"3"},
