		{"id":"n5","type":"text","text":"**Модель книги**\n5 уровней\nгибрид\nстр. 97–98","x":620,"y":300,"width":250,"height":110,"color":"4"},
		{"id":"n6","type":"text","text":"**Уровень передачи данных** то же, что канальный","x":900,"y":300,"width":250,"height":110,"color":"4"},
		{"id":"n7","type":"text","text":"## Три центральных понятия","x":1190,"y":190,"width":240,"height":70,"color":"3"},
		{"id":"n8","type":"text","text":"**Служба**\nнабор примитивов\nдля вышележащего\nинтерфейс","x":1190,"y":300,"width":250,"height":110,"color":"3"},
		{"id":"n9","type":"text","text":"**Интерфейс**\nкакие операции\nдаёт нижний уровень\nчто умеет","x":1470,"y":300,"width":250,"height":110,"color":"3"},
		{"id":"n10","type":"text","text":"**Протокол**\nправила обмена\nмежду пирами\nпакеты","x":1750,"y":300,"width":250,"height":110,"color":"3"},
