{
	"nodes":[
		{"id":"n1","type":"text","text":"# Глава 1\n**Введение**\n\n[[Глава 1]]","x":910,"y":0,"width":300,"height":150,"color":"6"},
		{"id":"n2","type":"text","text":"## Эталонные модели","x":60,"y":190,"width":240,"height":70,"color":"4"},
