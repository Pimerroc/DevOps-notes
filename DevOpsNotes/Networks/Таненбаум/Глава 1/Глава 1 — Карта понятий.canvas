		{"id":"n13","type":"text","text":"**LAN**\nздание\nвремя прохождения известно","x":340,"y":560,"width":250,"height":110,"color":"2"},
		{"id":"n14","type":"text","text":"**MAN**\nгород\nэволюция кабельного ТВ","x":620,"y":560,"width":250,"height":110,"color":"2"},
		{"id":"n15","type":"text","text":"**WAN**\nстрана, континент\nаренда или VPN","x":900,"y":560,"width":250,"height":110,"color":"2"},
		{"id":"n16","type":"text","text":"## Архитектура интернета","x":1190,"y":450,"width":240,"height":70,"color":"5"},
		{"id":"n17","type":"text","text":"**CDN**\nсеть доставки контента\nреплики ближе к пользователю","x":1190,"y":560,"width":250,"height":110,"color":"5"},
		{"id":"n18","type":"text","text":"**tier-1**\nне платит за транзит\nопорная сеть","x":1470,"y":560,"width":250,"height":110,"color":"5"},
		{"id":"n19","type":"text","text":"**IXP**\nточка обмена\nпиринг между ISP","x":1750,"y":560,"width":250,"height":110,"color":"5"},
		{"id":"n20","type":"text","text":"**POP**\nвход в сеть ISP\nместо входа пакетов","x":1190,"y":700,"width":250,"height":110,"color":"5"},
		{"id":"n21","type":"text","text":"**NAP**\nточка доступа\nисторическое, 1990-е","x":1470,"y":700,"width":250,"height":110,"color":"5"},
		{"id":"n22","type":"text","text":"**IXC**\nмежстанционный обмен\nтрафик между LATA","x":1750,"y":700,"width":250,"height":110,"color":"5"},
		{"id":"n23","type":"text","text":"## Сетевые устройства","x":60,"y":850,"width":240,"height":70,"color":"1"},
		{"id":"n24","type":"text","text":"**Коммутатор**\nсоединяет линии\nв пределах сети","x":60,"y":960,"width":250,"height":110,"color":"1"},
		{"id":"n25","type":"text","text":"**Маршрутизатор**\nсвязывает подсети\nуровень 3","x":340,"y":960,"width":250,"height":110,"color":"1"},
		{"id":"n26","type":"text","text":"**Шлюз**\nсоединяет сети\nлюбой уровень","x":620,"y":960,"width":250,"height":110,"color":"1"},
		{"id":"n27","type":"text","text":"**Точка доступа**\nбеспроводной узел\n802.11","x":900,"y":960,"width":250,"height":110,"color":"1"},
