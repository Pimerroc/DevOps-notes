		{"id":"n29","type":"text","text":"**Объёмы — двоичные**\n2¹⁰ · 2²⁰ · 2³⁰ · 2⁴⁰\nкратно степени двойки","x":1190,"y":960,"width":250,"height":110,"color":"6"},
		{"id":"n30","type":"text","text":"**Скорости — десятичные**\n10³ · 10⁶ · 10⁹ · 10¹²\nне степень двойки","x":1470,"y":960,"width":250,"height":110,"color":"6"},
		{"id":"n31","type":"text","text":"**«м» и «мк»**\nмилли и микро\nв мировых обозначениях µ","x":1750,"y":960,"width":250,"height":110,"color":"6"},
