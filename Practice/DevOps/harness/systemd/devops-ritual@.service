[Unit]
Description=OpenCode DevOps ritual (%i)
Documentation=file://%h/DevOps_Notes/Practice/DevOps/harness/README.md
After=basic.target

[Service]
Type=oneshot
WorkingDirectory=%h/DevOps_Notes
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/DevOps_Notes/Practice/DevOps/harness/run.sh %i
TimeoutStartSec=45min
Nice=10
